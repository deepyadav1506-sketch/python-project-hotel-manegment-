# ==============================================================================
# StayHome Hotel Management System - Environment Variables Example
# ==============================================================================

# Application Environment (development / production)
APP_ENV=development
DEBUG=True
SECRET_KEY=stayhome-development-secret-key-change-in-production-2026

# Database Connection URL:
# 1. Local Development (SQLite - default):
DATABASE_URL=sqlite:///./stayhome.db

# 2. Production (Neon PostgreSQL):
# Uncomment and replace with your Neon database connection string on Vercel:
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
